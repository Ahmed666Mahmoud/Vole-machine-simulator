@startuml Vole_Simulator_Architecture
!theme plain
skinparam classAttributeIconSize 0
skinparam roundcorner 8
skinparam linetype ortho
skinparam shadowing false
skinparam class {
    BackgroundColor White
    ArrowColor #2b5797
    BorderColor #2b5797
}

package "Presentation Layer (Qt GUI)" {
    class QMainWindow <<Qt Framework>> {
    }

    class MainWindow {
        - ui: Ui::MainWindow*
        - machine: Machine
        + MainWindow(parent: QWidget*)
        + ~MainWindow()
        - setupTables(): void
        - updateUI(): void
        - updateMemoryTable(): void
        - updateRegisterTable(): void
        - updateCPUState(): void
        - updateScreenOutput(): void
        - logMessage(msg: QString): void
        -- Qt Slots (UI Controls) --
        + on_btnLoad_clicked(): void
        + on_actionLoadFile_triggered(): void
        + on_btnStep_clicked(): void
        + on_actionStep_triggered(): void
        + on_btnRun_clicked(): void
        + on_actionRun_triggered(): void
        + on_btnReset_clicked(): void
        + on_actionReset_triggered(): void
        + on_btnClearAll_clicked(): void
        + on_actionClearAll_triggered(): void
        + on_btnSetMemory_clicked(): void
        + on_btnClearMemory_clicked(): void
        + on_actionClearMemory_triggered(): void
        + on_btnSetRegister_clicked(): void
        + on_btnClearRegisters_clicked(): void
        + on_actionClearRegisters_triggered(): void
        + on_btnClearScreen_clicked(): void
        + on_btnClearLog_clicked(): void
        + on_tableMemory_cellClicked(row: int, column: int): void
        + on_tableRegisters_cellClicked(row: int, column: int): void
        + on_actionExit_triggered(): void
    }

    class "Ui::MainWindow" as Ui_MainWindow <<Generated by UIC>> {
        + tableMemory: QTableWidget*
        + tableRegisters: QTableWidget*
        + textScreen: QPlainTextEdit*
        + textLog: QPlainTextEdit*
        + btnLoad: QPushButton*
        + btnStep: QPushButton*
        + btnRun: QPushButton*
        + btnReset: QPushButton*
        + btnClearAll: QPushButton*
        + btnClearMemory: QPushButton*
        + btnClearRegisters: QPushButton*
        + btnClearScreen: QPushButton*
        + setupUi(QMainWindow*): void
    }
}

package "Core Domain Layer (Vole Architecture)" {
    class Machine {
        - registers: RegisterBank
        - screen: Screen
        - memory: Memory
        - alu: ALU
        - cpu: CPU
        + Machine()
        + displayState(): void
        + loadProgram(filePath: string, address: int): bool
        + step(): void
        + run(): void
        + setMemoryCell(address: int, value: int): void
        + setRegisterValue(index: int, value: string): void
        + getMemoryCell(address: int): int
        + getRegisterValue(index: int): string
        + getScreenBuffer(): string
        + getPC(): int
        + getIR(): string
        + isHalted(): bool
        + reset(startAddress: int): void
        + clearScreen(): void
        + clearMemory(): void
        + clearRegisters(): void
        + fullReset(startAddress: int): void
    }

    class CPU {
        - PC: int
        - IR: string
        - Halted: bool
        - registers: RegisterBank&
        - memory: Memory&
        - screen: Screen&
        - alu: ALU&
        + CPU(registers: RegisterBank&, memory: Memory&, screen: Screen&, alu: ALU&)
        + reset(startAddress: int): void
        + isHalted(): bool
        + step(): void
        + getPC(): int
        + getIR(): string
        + setPC(pc: int): void
    }

    class ALU {
        + addTwoComplement(a: uint8_t, b: uint8_t): uint8_t
        + addFloatingPoint(a: uint8_t, b: uint8_t): uint8_t
        + bitewiseAND(a: uint8_t, b: uint8_t): uint8_t
        + bitewiseOR(a: uint8_t, b: uint8_t): uint8_t
        + bitewiseXOR(a: uint8_t, b: uint8_t): uint8_t
        + rotateRight(value: uint8_t, steps: int): uint8_t
    }

    class Memory {
        - cells: int[256]
        + Memory()
        + getCell(cellNumber: int): int
        + setCell(cellNumber: int, Newvalue: int): void
        + display(): void
        + clear(): void
    }

    class RegisterBank {
        - registers: string[16]
        + RegisterBank()
        + getRegister(regNum: int): string
        + setRegister(regNum: int, value: string): void
        + display(): void
        + clear(): void
    }

    class Screen {
        - outputbuffer: string
        + write(value: uint8_t): void
        + display(): void
        + getBuffer(): string
        + clear(): void
    }

    class ProgramLoader {
        + {static} loadFile(filePath: string, startAddress: int, memory: Memory&): bool
    }

    class MainMenu <<CLI Controller>> {
        - machine: Machine&
        + MainMenu(m: Machine&)
        + displayMenu(): void
        + handleChoice(choice: int): void
        + run(): void
    }
}

' Relationships & Associations
QMainWindow <|-- MainWindow : inherits
MainWindow o-- "1" Machine : manages / controls
MainWindow o-- "1" Ui_MainWindow : owns

Machine *-- "1" CPU : composes
Machine *-- "1" Memory : composes
Machine *-- "1" RegisterBank : composes
Machine *-- "1" ALU : composes
Machine *-- "1" Screen : composes
Machine ..> ProgramLoader : uses

CPU o-- "1" Memory : references
CPU o-- "1" RegisterBank : references
CPU o-- "1" ALU : references
CPU o-- "1" Screen : references

MainMenu o-- "1" Machine : interacts via CLI

@enduml
