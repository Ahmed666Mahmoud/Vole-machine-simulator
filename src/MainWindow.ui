  <!-- Status Bar -->
  <widget class="QStatusBar" name="statusbar"/>

  <!-- Actions -->
  <action name="actionLoadFile">
   <property name="text">
    <string>&amp;Load Program File...</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+O</string>
   </property>
  </action>
  <action name="actionExit">
   <property name="text">
    <string>E&amp;xit</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+Q</string>
   </property>
  </action>
  <action name="actionStep">
   <property name="text">
    <string>&amp;Step</string>
   </property>
   <property name="shortcut">
    <string>F10</string>
   </property>
  </action>
  <action name="actionRun">
   <property name="text">
    <string>&amp;Run All</string>
   </property>
   <property name="shortcut">
    <string>F5</string>
   </property>
  </action>
  <action name="actionReset">
   <property name="text">
    <string>&amp;Reset CPU</string>
   </property>
   <property name="shortcut">
    <string>F4</string>
   </property>
  </action>
  <action name="actionClearMemory">
