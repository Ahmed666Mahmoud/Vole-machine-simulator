   </property>
  </action>
  <action name="actionClearRegisters">
   <property name="text">
    <string>Clear &amp;Registers</string>
   </property>
  </action>
  <action name="actionClearAll">
   <property name="text">
    <string>Clear &amp;All (Full Reset)</string>
