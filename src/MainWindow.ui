        <widget class="QLineEdit" name="editStartAddress">
         <property name="maximumSize">
          <size>
           <width>60</width>
           <height>16777215</height>
          </size>
         </property>
         <property name="text">
          <string>00</string>
         </property>
         <property name="maxLength">
          <number>2</number>
         </property>
