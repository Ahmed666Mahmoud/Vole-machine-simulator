      <!-- Right Panel: Registers + Screen + Logs -->
      <widget class="QWidget" name="rightPanelWidget">
       <layout class="QVBoxLayout" name="rightPanelLayout">
        <!-- Registers -->
        <item>
         <widget class="QGroupBox" name="groupRegisters">
